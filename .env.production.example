# Copie para .env (local), .env.staging ou .env.production e preencha.
# NUNCA versione os arquivos .env reais - eles estao no .gitignore.

COMPOSE_PROJECT_NAME=esg-production
APP_ENV=production
API_PORT=8080
APP_IMAGE=ghcr.io/<usuario>/<repositorio>:<sha>

# Oracle (senha do SYS/SYSTEM e do usuario da aplicacao)
ORACLE_PASSWORD=troque-esta-senha
DB_USERNAME=APP_MOBILIDADE
DB_PASSWORD=troque-esta-senha

# Usuario Basic Auth para POST/PUT/DELETE
API_ADMIN_USER=admin
API_ADMIN_PASSWORD=troque-esta-senha

# Carga de dados de exemplo no primeiro start
APP_SEED_ENABLED=false
